NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway (Honey chat, visit prep, speech categorize)
AI_GATEWAY_API_KEY=

# Honey contextual floating assistant (v2). Set to 1 to enable the bottom-right pain invite + chat dock.
# Leave unset or 0 to keep v1 behavior only (Honey tab / full page unchanged either way).
NEXT_PUBLIC_HONEY_WIDGET_V2=

# Web Push (optional browser reminders)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protects /api/reminders/send (Vercel Cron sends Bearer CRON_SECRET)
CRON_SECRET=
